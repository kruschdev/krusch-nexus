# KruschNexus Environment Configuration (Air-Gapped & Local-First)

# PostgreSQL + pgvector Storage
POSTGRES_USER=krusch
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=krusch_nexus_db
DATABASE_URL=postgresql://krusch:replace_with_secure_password@localhost:5432/krusch_nexus_db

# Local Ollama Host & Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-large

# Watch Directory & State Machine
WATCH_DIR=./ingest_watch

# FastMCP Server Configuration
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8002
