# KruschNexus Environment Configuration

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=krusch_nexus_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krusch_nexus_db

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-large
OLLAMA_LLM_MODEL=qwen2.5-coder:7b

# Invariant Providers: Default to Local Ollama & Local PostgreSQL
TAGGING_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
NEXUS_DB_TARGET=local

# Optional Cloud Extensions (Leave empty for air-gapped local mode)
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=baai/bge-large-en-v1.5
POLYGRES_URL=

# Watch Folder Configuration
WATCH_DIR=./ingest_watch
ARCHIVE_DIR=./ingest_watch/.ingested
