FROM python:3.11-slim

WORKDIR /app

# Install system dependencies: build tools, PostgreSQL client libs, Poppler utilities, and Tesseract OCR
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    git \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt

# Bake source into image for standalone deployment (dev volume mount overrides this)
COPY src/ src/

EXPOSE 8000

CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
